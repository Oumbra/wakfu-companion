{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm start)",
      "Bash(npm start *)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm ls)",
      "Bash(node tools/*)",
      "Bash(npx ng *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(npx drizzle-kit generate*)",
      "Bash(npx wrangler pages dev*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",
      "Bash(sleep *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(nohup npm start)",
      "Bash(disown)",
      "Bash(pkill -f \"ng serve\")",
      "Bash(pkill -f *)",
      "Bash(npm ls *)",
      "Bash(rm -f /tmp/claude-*)"
    ],
    "deny": [
      "Read(./.vars)",
      "Read(./.vars.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .vars*)",
      "Bash(cat .dev.vars*)",
      "Bash(cat .env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v rtk >/dev/null 2>&1 || echo \"rtk absent de cette session : les commandes shell tournent en natif (cf. CLAUDE.md, section rtk). Cloud : installer rtk via le setup script de l environnement.\"'"
          },
          {
            "type": "command",
            "command": "sh -c 'grep -q \"\\\"caveman@caveman\\\"\" \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json\" 2>/dev/null || echo \"plugin caveman absent de cette session : appliquer la skill par la section Caveman de CLAUDE.md. Cloud : installer le plugin via le setup script de l environnement.\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v rtk >/dev/null 2>&1 && exec rtk hook claude; cat >/dev/null'"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  }
}

/* Config TypeScript pour le code serveur exécuté sur le runtime Workers/edge
   (functions/, server/db/) — séparée de tsconfig.app.json (qui ne couvre que
   src/, voir Angular CLI) ET de tsconfig.import.json (server/import/, runtime
   Node — globals incompatibles, voir ce fichier). Sert au typage éditeur et à
   une vérification manuelle (`npx tsc -p tsconfig.server.json --noEmit`) ; le
   bundling réel des Pages Functions au déploiement est fait par Wrangler,
   indépendamment de ce fichier. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/server",
    "types": ["@cloudflare/workers-types"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"]
  },
  "include": ["functions/**/*.ts", "server/**/*.ts"],
  "exclude": ["server/import/**"]
}

{
  "name": "wakfu-companion",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:items": "node tools/generate-wakfu-items-data.mjs",
    "generate:monsters": "node tools/generate-wakfu-monsters-data.mjs",
    "generate": "npm run generate:items && npm run generate:monsters",
    "start": "npm run generate && ng serve",
    "build": "npm run generate && ng build",
    "watch": "npm run generate && ng build --watch --configuration development",
    "test": "ng test",
    "build:standalone:compile": "npm run generate && ng build --configuration production,standalone",
    "build:standalone": "npm run build:standalone:compile && node tools/build-standalone.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^26.1.2",
    "@types/wicg-file-system-access": "^2023.10.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}

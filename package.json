{
  "name": "wakfu-companion",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "generate:items": "node tools/generate-wakfu-items-data.mjs",
    "generate:monsters": "node tools/generate-wakfu-monsters-data.mjs",
    "generate:dungeons": "node tools/generate-wakfu-dungeons-data.mjs",
    "generate:build-info": "node tools/generate-build-info.mjs",
    "generate": "npm run generate:items && npm run generate:monsters && npm run generate:dungeons && npm run generate:build-info",
    "start": "npm run generate && ng serve",
    "build": "npm run generate && ng build",
    "watch": "npm run generate && ng build --watch --configuration development",
    "test": "npm run generate && ng test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "install:ci": "npx --yes npm@10.9.8 install"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "@types/wicg-file-system-access": "^2023.10.7",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}

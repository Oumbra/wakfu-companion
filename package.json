{
  "name": "wakfu-companion",
  "version": "1.47.1",
  "scripts": {
    "ng": "ng",
    "generate:build-info": "node tools/generate-build-info.mjs",
    "generate": "npm run generate:build-info",
    "start": "npm run generate && concurrently -n ng,api -c blue,magenta \"ng serve\" \"npm run functions:dev\"",
    "functions:dev": "wrangler pages dev public --port 8788 --compatibility-date 2026-08-07 --compatibility-flags nodejs_compat",
    "build": "npm run generate && ng build",
    "watch": "npm run generate && ng build --watch --configuration development",
    "test": "npm run generate && ng test",
    "test:server": "vitest run --config vitest.server.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-migrations": "tsx server/import/verify-migrations.ts",
    "catalog:import": "tsx server/import/import-catalog.ts",
    "main:db:generate": "node tools/with-vars.mjs npm run db:generate",
    "main:db:migrate": "node tools/with-vars.mjs npm run db:migrate",
    "main:catalog:import": "node tools/with-vars.mjs npm run catalog:import",
    "dev:db:generate": "node tools/with-dev-vars.mjs npm run db:generate",
    "dev:db:migrate": "node tools/with-dev-vars.mjs npm run db:migrate",
    "dev:catalog:import": "node tools/with-dev-vars.mjs npm run catalog:import",
    "install:ci": "npx --yes npm@10.9.8 install",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "@types/wicg-file-system-access": "^2023.10.7",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.11",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
